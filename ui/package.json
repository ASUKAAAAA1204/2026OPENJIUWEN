{
  "name": "assurance-ledger-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Assurance Ledger Studio UI —— ARS 面板 + 闸门 + 曲线",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "lint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write \"{src,scripts,tests,e2e}/**/*.{ts,js,mjs,vue,css,json}\"",
    "check:contract": "node scripts/check-contract.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --workers=1",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "budget": "node scripts/budget.mjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:style && npm run check:contract && npm run test && npm run build && npm run budget && npm run test:e2e && npm run test:performance"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "uplot": "^1.6.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.2.0",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.0.0"
  },
  "license": "MIT",
  "notes": "选 Vue 而非 React：轻量、单页 Studio 足够；uPlot 用于保证-成本曲线渲染"
}
