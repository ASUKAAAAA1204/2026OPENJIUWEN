{
  "id": "A-resolver-adversarial-v1",
  "cases": [
    {"id":"csv-number","sources":{"source.csv":"company,pe\nA,12\nB,30\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"RESOLVED"},
    {"id":"csv-second-row","sources":{"source.csv":"company,pe\nA,12\nB,30\n"},"locator":{"file":"source.csv","row":2,"field":"pe"},"value":30,"expected_status":"RESOLVED"},
    {"id":"csv-bom-crlf","sources":{"source.csv":"﻿company,pe\r\nA,12.0\r\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"RESOLVED"},
    {"id":"multiline-record","sources":{"source.csv":"company,note\nA,\"one\ntwo\"\nB,three\n"},"locator":{"file":"source.csv","row":2,"field":"note"},"value":"THREE","expected_status":"RESOLVED"},
    {"id":"unicode-field","sources":{"source.csv":"公司,数值\n甲,十二\n"},"locator":{"file":"source.csv","row":1,"field":"数值"},"value":"十 二","expected_status":"RESOLVED"},
    {"id":"text-case-whitespace","sources":{"note.txt":"标题\nHello  WORLD\n"},"locator":{"file":"note.txt","line":2},"value":"helloworld","expected_status":"RESOLVED"},
    {"id":"within-relative-tolerance","sources":{"note.txt":"1000000.5\n"},"locator":{"file":"note.txt","line":1},"value":"1000000","expected_status":"RESOLVED"},
    {"id":"negative-relative-tolerance","sources":{"note.txt":"-1000000.5\n"},"locator":{"file":"note.txt","line":1},"value":"-1000000","expected_status":"RESOLVED"},
    {"id":"zero-equal","sources":{"note.txt":"0\n"},"locator":{"file":"note.txt","line":1},"value":0,"expected_status":"RESOLVED"},
    {"id":"empty-text-line","sources":{"note.txt":"title\n\n"},"locator":{"file":"note.txt","line":2},"value":"","expected_status":"RESOLVED"},
    {"id":"value-changed","sources":{"source.csv":"company,pe\nA,13\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"VALUE_MISMATCH"},
    {"id":"outside-tolerance","sources":{"note.txt":"1000002\n"},"locator":{"file":"note.txt","line":1},"value":"1000000","expected_status":"VALUE_MISMATCH"},
    {"id":"zero-no-absolute-slack","sources":{"note.txt":"0.000000000001\n"},"locator":{"file":"note.txt","line":1},"value":0,"expected_status":"VALUE_MISMATCH"},
    {"id":"nonfinite-nan","sources":{"note.txt":"NaN\n"},"locator":{"file":"note.txt","line":1},"value":"NaN","expected_status":"VALUE_MISMATCH"},
    {"id":"nonfinite-infinity","sources":{"note.txt":"Infinity\n"},"locator":{"file":"note.txt","line":1},"value":"Infinity","expected_status":"VALUE_MISMATCH"},
    {"id":"different-text","sources":{"note.txt":"approved\n"},"locator":{"file":"note.txt","line":1},"value":"rejected","expected_status":"VALUE_MISMATCH"},
    {"id":"missing-file","sources":{},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"row-zero","sources":{"source.csv":"company,pe\nA,12\n"},"locator":{"file":"source.csv","row":0,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"row-absent","sources":{"source.csv":"company,pe\nA,12\n"},"locator":{"file":"source.csv","row":99,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"field-absent","sources":{"source.csv":"company,pe\nA,12\n"},"locator":{"file":"source.csv","row":1,"field":"price"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"line-zero","sources":{"note.txt":"12\n"},"locator":{"file":"note.txt","line":0},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"line-absent","sources":{"note.txt":"12\n"},"locator":{"file":"note.txt","line":99},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"missing-locator","sources":{"note.txt":"12\n"},"locator":null,"value":12,"expected_status":"NOT_FOUND"},
    {"id":"file-only","sources":{"note.txt":"12\n"},"locator":{"file":"note.txt"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"missing-expected","sources":{"note.txt":"12\n"},"locator":{"file":"note.txt","line":1},"value":null,"expected_status":"NOT_FOUND"},
    {"id":"ambiguous-locator","sources":{"source.csv":"company,pe\nA,12\n"},"locator":{"file":"source.csv","line":2,"row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"unregistered-file","sources":{},"locator":{"file":"another.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"parent-traversal","sources":{},"locator":{"file":"../outside.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"absolute-path","sources":{},"locator":{"file":"C:/not-allowed.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"duplicate-header","sources":{"source.csv":"company,pe,pe\nA,12,13\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"short-record","sources":{"source.csv":"company,pe\nA\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"extra-column","sources":{"source.csv":"company,pe\nA,12,extra\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"bad-quoted-record","sources":{"source.csv":"company,pe\nA,\"unterminated\n"},"locator":{"file":"source.csv","row":1,"field":"pe"},"value":12,"expected_status":"NOT_FOUND"},
    {"id":"invalid-utf8","sources":{"note.txt":{"base64":"//4="}},"locator":{"file":"note.txt","line":1},"value":12,"expected_status":"NOT_FOUND"}
  ]
}
